{
  "meta": {
    "dataset": "HAYAH availability, states and virtual sensors",
    "version": "0.1-draft",
    "synthetic": true,
    "note": "Entirely synthetic data; unrelated to any real patient or hospital & this file made to cover taj and ammar work as the plane",
    "schema_basis": "APPROVED_SCOPE_0.3v_MPS",
    "compatible_with": {
      "file": "hayah_master_data_v0_3.json",
      "version": "0.3-draft",
      "shared_keys": [
        "department_id",
        "equipment_id",
        "bed_id",
        "staff_id",
        "ambulance_id",
        "patient_id"
      ]
    },
    "owners": {
      "availability_states_transitions": "Taj - Electrical Engineering",
      "virtual_sensors": "Omar - Electrical Engineering"
    },
    "snapshot_timestamp": "2026-11-05T08:00:00Z",
    "naming_convention": "Keys are snake_case in English and department identifiers match the master file; status values follow the letter casing used in the master file for each entity (beds/equipment lowercase, staff capitalized) pending DEC-06",
    "assumptions": [
      "All durations, thresholds and update frequencies are design assumptions, not real measurements",
      "States flagged in_master_v0_3 = false are proposals; they need approval and must be added to the master file"
    ]
  },
  "availability": {
    "state_models": {
      "bed": {
        "master_collection": "beds",
        "id_field": "bed_id",
        "status_field": "status",
        "states": [
          {
            "value": "available",
            "in_master_v0_3": true,
            "counts_toward_effective_capacity": true,
            "description": "Bed ready to receive a patient"
          },
          {
            "value": "occupied",
            "in_master_v0_3": true,
            "counts_toward_effective_capacity": true,
            "description": "Bed occupied by a patient"
          },
          {
            "value": "cleaning",
            "in_master_v0_3": false,
            "counts_toward_effective_capacity": true,
            "description": "[proposed] Bed turnover after patient leaves; temporary, returns to available"
          },
          {
            "value": "out_of_service",
            "in_master_v0_3": true,
            "counts_toward_effective_capacity": false,
            "description": "Bed out of service (fault or long maintenance)"
          }
        ]
      },
      "equipment": {
        "master_collection": "equipment",
        "id_field": "equipment_id",
        "status_field": "status",
        "states": [
          {
            "value": "available",
            "in_master_v0_3": true,
            "operational": true,
            "description": "Device working and not in use"
          },
          {
            "value": "in_use",
            "in_master_v0_3": true,
            "operational": true,
            "description": "Device working and currently in use"
          },
          {
            "value": "maintenance",
            "in_master_v0_3": false,
            "operational": false,
            "description": "[proposed] Scheduled maintenance; temporary"
          },
          {
            "value": "out_of_service",
            "in_master_v0_3": false,
            "operational": false,
            "description": "[proposed] Fault; device unavailable until repaired"
          }
        ]
      },
      "staff": {
        "master_collection": "staff",
        "id_field": "staff_id",
        "status_field": "status",
        "states": [
          {
            "value": "Available",
            "in_master_v0_3": true,
            "description": "Available"
          },
          {
            "value": "Busy",
            "in_master_v0_3": true,
            "description": "Busy"
          }
        ]
      }
    },
    "transitions": [
      {
        "transition_id": "TR-BED-01",
        "entity_type": "bed",
        "from": "available",
        "to": "occupied",
        "trigger": "Patient admitted to the bed",
        "duration_minutes": null,
        "side_effects": [
          "occupied(department)+1"
        ]
      },
      {
        "transition_id": "TR-BED-02",
        "entity_type": "bed",
        "from": "occupied",
        "to": "cleaning",
        "trigger": "Patient discharged or transferred to another department",
        "duration_minutes": null,
        "side_effects": [
          "occupied(department)-1"
        ]
      },
      {
        "transition_id": "TR-BED-03",
        "entity_type": "bed",
        "from": "cleaning",
        "to": "available",
        "trigger": "Turnover completed",
        "duration_minutes": {
          "ED-01": [
            10,
            20
          ],
          "ICU-01": [
            20,
            40
          ],
          "WARD-01": [
            15,
            30
          ]
        },
        "side_effects": []
      },
      {
        "transition_id": "TR-BED-04",
        "entity_type": "bed",
        "from": "available",
        "to": "out_of_service",
        "trigger": "Bed fault or shutdown",
        "duration_minutes": null,
        "side_effects": [
          "capacity_effective(department)-1"
        ]
      },
      {
        "transition_id": "TR-BED-05",
        "entity_type": "bed",
        "from": "cleaning",
        "to": "out_of_service",
        "trigger": "Fault detected during turnover",
        "duration_minutes": null,
        "side_effects": [
          "capacity_effective(department)-1"
        ]
      },
      {
        "transition_id": "TR-BED-06",
        "entity_type": "bed",
        "from": "out_of_service",
        "to": "cleaning",
        "trigger": "Repair completed (goes through turnover before becoming available)",
        "duration_minutes": null,
        "side_effects": [
          "capacity_effective(department)+1"
        ]
      },
      {
        "transition_id": "TR-EQ-01",
        "entity_type": "equipment",
        "from": "available",
        "to": "in_use",
        "trigger": "Device starts being used for a patient",
        "duration_minutes": null,
        "side_effects": []
      },
      {
        "transition_id": "TR-EQ-02",
        "entity_type": "equipment",
        "from": "in_use",
        "to": "available",
        "trigger": "Usage ended",
        "duration_minutes": null,
        "side_effects": []
      },
      {
        "transition_id": "TR-EQ-03",
        "entity_type": "equipment",
        "from": "available",
        "to": "maintenance",
        "trigger": "Scheduled maintenance",
        "duration_minutes": null,
        "side_effects": [
          "See availability_impact"
        ]
      },
      {
        "transition_id": "TR-EQ-04",
        "entity_type": "equipment",
        "from": "maintenance",
        "to": "available",
        "trigger": "Maintenance completed",
        "duration_minutes": null,
        "side_effects": []
      },
      {
        "transition_id": "TR-EQ-05",
        "entity_type": "equipment",
        "from": "available",
        "to": "out_of_service",
        "trigger": "Fault",
        "duration_minutes": null,
        "side_effects": [
          "See availability_impact"
        ]
      },
      {
        "transition_id": "TR-EQ-06",
        "entity_type": "equipment",
        "from": "in_use",
        "to": "out_of_service",
        "trigger": "Fault during use",
        "duration_minutes": null,
        "side_effects": [
          "See availability_impact",
          "Current patient returns to Waiting status"
        ]
      },
      {
        "transition_id": "TR-EQ-07",
        "entity_type": "equipment",
        "from": "out_of_service",
        "to": "maintenance",
        "trigger": "Repair started",
        "duration_minutes": null,
        "side_effects": []
      },
      {
        "transition_id": "TR-STF-01",
        "entity_type": "staff",
        "from": "Available",
        "to": "Busy",
        "trigger": "Assigned to a patient case",
        "duration_minutes": null,
        "side_effects": []
      },
      {
        "transition_id": "TR-STF-02",
        "entity_type": "staff",
        "from": "Busy",
        "to": "Available",
        "trigger": "Task completed",
        "duration_minutes": null,
        "side_effects": []
      }
    ],
