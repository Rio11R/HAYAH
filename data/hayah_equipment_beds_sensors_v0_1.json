    "availability_impact": {
      "parameters_are_assumptions": true,
      "pressure_formula": {
        "expression": "(occupied + predicted_incoming) / capacity_effective",
        "thresholds": {
          "Critical": ">= 0.9",
          "Warning": ">= 0.7",
          "Normal": "otherwise"
        },
        "zero_capacity_rule": "If capacity_effective = 0 the status is Critical",
        "note": "Same department_status thresholds as in Abdullah's file; the only difference is replacing capacity with capacity_effective"
      },
      "capacity_effective_rules": [
        {
          "rule_id": "AV-CAP-01",
          "applies_to": [
            "ED-01",
            "ICU-01",
            "WARD-01"
          ],
          "expression": "Count of the department's beds records whose status is not out_of_service"
        },
        {
          "rule_id": "AV-CAP-02",
          "applies_to": [
            "RAD-CT",
            "LAB-01"
          ],
          "expression": "capacity * (operational devices in the department / total devices in the department)"
        }
      ],
      "equipment_rules": [
        {
          "rule_id": "AV-EQ-01",
          "equipment_id": "EQ-CT-01",
          "when_status_in": [
            "maintenance",
            "out_of_service"
