    "derivation_rules": {
      "occupied": "إجمالي المرضى في القسم لحظة اللقطة (Waiting + In_service)، ويشمل مرضى خلفية غير مدرجين في patients؛ سجلات patients هي المرضى المتتبَّعون (50) وليست كامل الإشغال",
      "predicted_incoming": "عدد المرضى الذين next_department_id = القسم وcurrent_department مختلف عنه (يشمل مرضى الإسعاف En_route)",
      "department_status": "(occupied + predicted_incoming) / capacity: ≥0.9 Critical، ≥0.7 Warning، غير ذلك Normal",
      "capacity": "للأقسام ذات الأسرّة (ED-01, ICU-01, WARD-01) = عدد سجلات beds للقسم؛ للأشعة والمختبر = سعة استقبال بعدد المرضى (لا أسرّة)",
      "queue_length": "عدد سجلات patients بحالة Waiting في القسم (من السجلات المتتبَّعة فقط)",
      "predicted_path": "يبدأ بالقسم الحالي (أو بقسم الوصول الأول لمرضى الإسعاف) ويتطابق مع next_department_id",
      "beds": "حالة الأسرّة متسقة مع occupied لكل قسم ذي أسرّة؛ لا أسرّة لـ RAD-CT وLAB-01"
    },
    "triage_basis": {
